{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{templates/**,static/**,roadsense.db}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/diag",
      "destination": "/api/diag.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
