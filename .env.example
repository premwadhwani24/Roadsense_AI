# Road Condition Zoning & Scoring Configuration
ROAD_ZONE_RED_THRESHOLD=40
ROAD_ZONE_YELLOW_THRESHOLD=70
ROAD_SCORE_WEIGHTS={"damage_severity":1.0,"traffic":1.0,"weather":1.0,"satellite":1.0,"citizen":1.0,"repair_history":1.0,"live_stream":1.0}

